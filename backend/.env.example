# MongoDB connection (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/totalops

# Secret used to sign admin JWTs — change in production (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Comma separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:3000

# Public URL of the frontend (used to build customer review / dealer / form links)
PUBLIC_APP_URL=http://localhost:3000

# Seeded admin (created automatically the first time the database is empty)
ADMIN_EMAIL=admin@totalops.app
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Workspace Admin

# Folder for uploaded files (relative to backend/ or absolute)
STORAGE_DIR=storage

# Optional — Claude vision: photo -> vehicle detection (make/model/body/colour/windows)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional — Meshy image-to-3D: photo -> real 3D mesh (GLB)
MESHY_API_KEY=
